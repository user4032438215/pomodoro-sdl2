@startuml
skinparam classAttributeIconSize 0

class App {
  - Settings settings_
  - PomodoroSession session_
  - PomodoroTimer timer_
  - PomodoroRenderer renderer_
  - bool running_
  - AppScreen screen_
  - SDL_Rect start_button_
  - SDL_Rect reset_button_
  - SDL_Rect settings_button_
  - SDL_Rect work_minus_button_
  - SDL_Rect work_plus_button_
  - SDL_Rect back_button_

  + init()
  + run()
  + timer_state()
  + session_type()
  + remaining_seconds()
  + progress()
  + button_label()
  - handle_events()
  - update()
  - render()
  - render_timer_screen()
  - render_settings_screen()
  - is_inside()
  - start_current_session()
  - reset_current_timer()
  - start_current_timer()
}

class Settings {
  - PomodoroConfig current_config_
  + apply()
  + save()
  + current()
  + defaults()
  - validate_config()
}

class PomodoroConfig {
  + int work_minutes
  + int short_break_minutes
  + int long_break_minutes
  + int long_break_interval
}

class PomodoroSession {
  - const Settings& settings_
  - int completed_work_sessions_
  - SessionType current_

  + next()
  + reset()
  + get_type()
  + get_duration_minutes()
  + get_session_name()
  + should_take_long_break()
  + completed_work_sessions()
}

class PomodoroTimer {
  - int duration_sec_
  - Duration accumulated_elapsed_
  - TimePoint last_start_at_
  - TimerState state_

  + start()
  + pause()
  + resume()
  + reset()
  + update()
  + is_finished()
  + get_state()
  + get_remaining_seconds()
  + get_progress()
}

class PomodoroRenderer {
  - SDL_Window* window_
  - SDL_Renderer* renderer_
  - TTF_Font* font_

  + init()
  + shutdown()
  + clear()
  + present()
  + render_text()
  + render_timer()
  + render_session_name()
  + render_progress_bar()
  + render_button()
  - format_time()
}

class Button {
  - SDL_Rect bounds_
  - std::string label_

  + contains()
  + render()
  + label()
  + set_label()
}

enum AppScreen {
  TIMER
  SETTINGS
}

enum SessionType {
  WORK
  SHORT_BREAK
  LONG_BREAK
}

enum TimerState {
  IDLE
  RUNNING
  PAUSED
  FINISHED
}

App --> Settings : uses
App --> PomodoroSession : uses
App --> PomodoroTimer : uses
App --> PomodoroRenderer : uses
App --> AppScreen : owns
Settings --> PomodoroConfig : owns
PomodoroSession --> Settings : reads
PomodoroSession --> SessionType : owns
PomodoroTimer --> TimerState : owns
App ..> Button : planned refactor
@enduml