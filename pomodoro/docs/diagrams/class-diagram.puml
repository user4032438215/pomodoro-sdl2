@startuml

title Pomodoro Timer MVP - Layered UI Architecture

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

hide empty members

package "Core" {

    enum SessionType {
        WORK
        SHORT_BREAK
        LONG_BREAK
    }

    enum TimerState {
        IDLE
        RUNNING
        PAUSED
        FINISHED
    }

    class PomodoroConfig <<data>> {
        + work_minutes : int = 25
        + short_break_minutes : int = 5
        + long_break_minutes : int = 15
        + long_break_interval : int = 4
    }

    class Settings {
        - defaults_ : const PomodoroConfig
        - current_ : PomodoroConfig

        + Settings()

        + load(path : string) : bool
        + save(path : string) : bool

        + apply(config : PomodoroConfig) : bool
        + reset_to_defaults() : void

        + current() : const PomodoroConfig&
        + defaults() : const PomodoroConfig&

        + validate() : bool
        {static} + validate(config : PomodoroConfig) : bool
    }

    class PomodoroSession {
        - settings_ : const Settings&
        - completed_work_sessions_ : int = 0
        - current_ : SessionType = WORK

        + PomodoroSession(settings : const Settings&)

        + next() : void
        + reset() : void

        + get_type() : SessionType
        + get_duration_minutes() : int
        + get_session_name() : string
        + should_take_long_break() : bool
        + completed_work_sessions() : int
    }

    class PomodoroTimer {
        - duration_sec_ : int
        - accumulated_elapsed_ : steady_clock::duration
        - last_start_at_ : steady_clock::time_point
        - state_ : TimerState

        - get_elapsed_duration() : steady_clock::duration

        + PomodoroTimer(duration_sec : int)

        + start() : void
        + pause() : void
        + resume() : void
        + reset(duration_sec : int) : void
        + update() : void

        + get_remaining_seconds() : int
        + get_progress() : float
        + is_finished() : bool
        + get_state() : TimerState
    }
}

package "UI Model" {

    enum AppScreen {
        TIMER
        SETTINGS
    }

    class SettingsDraft <<data>> {
        + config : PomodoroConfig
    }

    class Button <<data>> {
        + bounds : SDL_Rect
        + label : string
        + enabled : bool
        + hovered : bool

        + contains(x : int, y : int) : bool
    }
}

package "UI Rendering Infrastructure" {

    class PomodoroRenderer {
        - window_ : SDL_Window*
        - renderer_ : SDL_Renderer*
        - font_ : TTF_Font*

        + PomodoroRenderer()
        + ~PomodoroRenderer()

        + init(title : string, width : int, height : int) : bool
        + shutdown() : void

        + clear() : void
        + present() : void

        + render_text(
            text : string,
            x : int,
            y : int
        ) : void

        + render_button(
            button : Button
        ) : void

        + render_progress_circle(
            progress : float
        ) : void
    }
}

package "UI Screens" {

    class TimerScreenView {
        - renderer_ : PomodoroRenderer&

        + TimerScreenView(renderer : PomodoroRenderer&)

        + render(
            session_name : string,
            remaining_sec : int,
            progress : float,
            completed_count : int,
            state : TimerState
        ) : void
    }

    class SettingsScreenView {
        - renderer_ : PomodoroRenderer&

        + SettingsScreenView(renderer : PomodoroRenderer&)

        + render(
            config : PomodoroConfig,
            buttons : Button[]
        ) : void
    }
}

package "Application" {

    class App {
        - settings_ : Settings
        - session_ : PomodoroSession
        - timer_ : PomodoroTimer

        - renderer_ : PomodoroRenderer
        - timer_screen_ : TimerScreenView
        - settings_screen_ : SettingsScreenView

        - screen_ : AppScreen = TIMER
        - settings_draft_ : SettingsDraft
        - running_ : bool = true

        - start_button_ : Button
        - pause_resume_button_ : Button
        - reset_button_ : Button
        - settings_button_ : Button

        - save_settings_button_ : Button
        - cancel_settings_button_ : Button
        - defaults_settings_button_ : Button

        + App()
        + init() : bool
        + run() : void

        - handle_events() : void
        - handle_timer_screen_click(x : int, y : int) : void
        - handle_settings_screen_click(x : int, y : int) : void

        - update() : void
        - render() : void

        - open_settings_screen() : void
        - close_settings_screen() : void
        - save_settings() : bool
        - cancel_settings() : void
        - reset_settings_draft() : void

        - reset_current_timer() : void
        - advance_to_next_session() : void
    }
}

package "Entry Point" {
    class Main {
        + main() : int
    }
}

' Core ownership and dependencies
Settings *-- PomodoroConfig : defaults/current
PomodoroSession --> Settings : reads current config
PomodoroSession --> SessionType
PomodoroTimer --> TimerState

' Application ownership
App *-- Settings
App *-- PomodoroSession
App *-- PomodoroTimer
App *-- PomodoroRenderer
App *-- TimerScreenView
App *-- SettingsScreenView

' Application UI state
App *-- AppScreen
App *-- SettingsDraft
App *-- Button

' View dependencies
TimerScreenView --> PomodoroRenderer : uses
SettingsScreenView --> PomodoroRenderer : uses
SettingsScreenView --> PomodoroConfig : displays
SettingsScreenView --> Button : displays

' Application coordination
App --> PomodoroSession : controls
App --> PomodoroTimer : controls
App --> TimerScreenView : updates
App --> SettingsScreenView : updates

' Entry point
Main --> App : creates

note right of PomodoroRenderer
  Owns SDL resources and provides
  low-level drawing operations.

  It should not decide:
  - when a timer starts
  - when a session changes
  - whether settings are valid
end note

note right of TimerScreenView
  Timer screen presentation only.

  It formats and arranges:
  - MM:SS
  - session name
  - progress circle
  - completed count
  - timer state
end note

note right of SettingsScreenView
  Settings screen presentation only.

  It draws:
  - setting labels
  - current draft values
  - plus/minus buttons
  - save/cancel/default buttons
end note

note right of App
  Application orchestration only.

  It handles:
  - SDL events
  - screen transitions
  - button actions
  - Timer and Session coordination
end note

@enduml