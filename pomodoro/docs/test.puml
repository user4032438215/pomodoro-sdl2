@startuml

class Settings {
    - work_minutes_ : int
    - short_break_minutes_ : int
    - long_break_minutes_ : int
    - long_break_interval_ : int

    + load(path : string) : bool
    + save(path : string) : bool
    + validate() : bool
    + work_minutes() : int
    + short_break_minutes() : int
    + long_break_minutes() : int
    + long_break_interval() : int
}

class PomodoroSession {
    - settings_ : Settings&
    - completed_work_sessions_ : int
    - current_ : SessionType

    + next() : void
    + reset() : void
    + get_type() : SessionType
    + get_duration_minutes() : int
    + get_session_name() : string
    + should_take_long_break() : bool
}

class PomodoroTimer {
    - duration_sec_ : int
    - accumulated_elapsed_ : duration
    - last_start_at_ : time_point
    - state_ : TimerState

    + start() : void
    + pause() : void
    + resume() : void
    + reset(duration_sec : int) : void
    + update() : void
}

class App {
    - settings_ : Settings
    - session_ : PomodoroSession
    - timer_ : PomodoroTimer
}

PomodoroSession --> Settings : references
App *-- Settings
App *-- PomodoroSession
App *-- PomodoroTimer

@enduml