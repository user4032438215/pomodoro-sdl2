@startuml

title Pomodoro Timer - Current Class Design

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

package "Core" {

    enum SessionType {
        WORK
        SHORT_BREAK
        LONG_BREAK
    }

    enum TimerState {
        IDLE
        RUNNING
        PAUSED
        FINISHED
    }

    class Settings {
        - work_minutes_ : int = 25
        - short_break_minutes_ : int = 5
        - long_break_minutes_ : int = 15
        - long_break_interval_ : int = 4

        + load(path : string) : bool
        + validate() : bool
        + work_minutes() : int
        + short_break_minutes() : int
        + long_break_minutes() : int
        + long_break_interval() : int
    }

    class PomodoroSession {
        - settings_ : const Settings&
        - completed_work_sessions_ : int = 0
        - current_ : SessionType = WORK

        + PomodoroSession(settings : const Settings&)
        + next() : void
        + reset() : void
        + get_type() : SessionType
        + get_duration_minutes() : int
        + get_session_name() : string
        + should_take_long_break() : bool
        + completed_work_sessions() : int
    }

    class PomodoroTimer {
        - duration_sec_ : int
        - accumulated_elapsed_ : steady_clock::duration
        - last_start_at_ : steady_clock::time_point
        - state_ : TimerState

        - get_elapsed_duration() : steady_clock::duration

        + PomodoroTimer(duration_sec : int)
        + start() : void
        + pause() : void
        + resume() : void
        + reset(duration_sec : int) : void
        + update() : void
        + get_remaining_seconds() : int
        + get_progress() : float
        + is_finished() : bool
        + get_state() : TimerState
    }
}

package "UI" {

    class PomodoroRenderer {
        - window_ : SDL_Window*
        - renderer_ : SDL_Renderer*
        - font_ : TTF_Font*

        + PomodoroRenderer()
        + ~PomodoroRenderer()
        + init(title : string, width : int, height : int) : bool
        + shutdown() : void
        + clear() : void
        + render_text(text : string, x : int, y : int) : void
        + render_timer(remaining_sec : int, progress : float) : void
        + render_session_name(name : string) : void
        + render_progress_bar(progress : float) : void
        + present() : void
    }
}

package "Application" {

    class App {
        - settings_ : Settings
        - session_ : PomodoroSession
        - timer_ : PomodoroTimer
        - renderer_ : PomodoroRenderer
        - running_ : bool = true

        + App()
        + init() : bool
        + run() : void

        - handle_events() : void
        - update() : void
        - render() : void
        - start_current_session() : void
    }
}

package "Entry Point" {

    class Main {
        + main() : int
    }
}

' Ownership relationships
App *-- Settings : owns
App *-- PomodoroSession : owns
App *-- PomodoroTimer : owns
App *-- PomodoroRenderer : owns

' Reference/dependency relationships
PomodoroSession --> Settings : references
PomodoroSession --> SessionType
PomodoroTimer --> TimerState

' Application usage relationships
App --> PomodoroSession : controls
App --> PomodoroTimer : controls
App --> PomodoroRenderer : calls

Main --> App : creates

@enduml